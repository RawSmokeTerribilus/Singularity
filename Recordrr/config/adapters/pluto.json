{
  "service": "pluto",
  "url": "https://pluto.tv/",
  "_note": "Strategies are ordered; first match wins. Tune against the live DOM using the drift report (option in the Recordrr menu). Anchor on role/aria/text, not layout classes.",
  "timing": {
    "play_settle": 8,
    "ad_poll": 1,
    "end_pad": 2,
    "max_runtime_factor": 2.2
  },
  "live": {
    "_note": "Linear-TV (live channels). Primary signals come from the page's own Redux store (window.appStore) via modules/guide.py — EPG, ad/mute/fit state. The DOM controls below stay as fallbacks. See recordrr-asbuilt §20.",
    "url": "https://pluto.tv/en/live-tv",
    "store": true,
    "timing": {
      "ad_poll": 2,
      "play_settle": 6,
      "max_runtime_factor": 1.6,
      "login_wait": 900
    }
  },
  "controls": {
    "play": [
      {
        "role": "button",
        "name": "(?i)^play"
      },
      {
        "css": "button[aria-label*='Play' i]"
      },
      {
        "css": "[data-testid*='play' i], .video-player__play"
      }
    ],
    "skip_intro": [
      {
        "role": "button",
        "name": "(?i)skip intro|skip recap"
      },
      {
        "text": "(?i)skip intro"
      },
      {
        "css": "button[class*='skip' i], [class*='skip-intro' i] button"
      }
    ],
    "next_episode": [
      {
        "role": "button",
        "name": "(?i)next episode|up next|play next"
      },
      {
        "text": "(?i)next episode|up next"
      },
      {
        "css": "[data-testid*='next' i], [class*='next-episode' i]"
      }
    ],
    "ad_marker": [
      {
        "css": "[aria-label*='ad break' i]"
      },
      {
        "text": "(?i)playing ads|publicidad|anuncio|advertisement|commercial|ad break"
      },
      {
        "css": "[class*='AdProgressBar' i], [class*='adBreak' i], [class*='ad-countdown' i], [data-testid*='ad' i], [class*='advertisement' i], [class*='commercial' i]"
      }
    ],
    "fullscreen": [
      {
        "role": "button",
        "name": "(?i)full ?screen"
      },
      {
        "css": "button[aria-label*='full' i]"
      }
    ],
    "unmute": [
      {
        "role": "button",
        "name": "(?i)un-?mute|^mute"
      },
      {
        "css": "button[class*='unmuteButton' i], button[class*='muteButton' i]"
      },
      {
        "css": "button[aria-label*='mute' i]"
      }
    ]
  },
  "display": "Pluto TV"
}